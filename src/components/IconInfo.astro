---
// Icônes ligne pour les info-cards (remplace les emojis, rendu cohérent cross-OS)
interface Props {
  name: 'flight' | 'visa' | 'car' | 'home' | 'health' | 'backpack';
}

const { name } = Astro.props;

const icons: Record<Props['name'], string> = {
  flight: `<path d="M3 11.5 20 4l-6.5 17-2.7-7-7.8-2.5z"/>`,
  visa: `<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><path d="M6 15.5c0-1.4 1.1-2.5 2.5-2.5s2.5 1.1 2.5 2.5"/><path d="M14 9h5M14 12h5M14 15h3"/>`,
  car: `<path d="M4 16v-3.5L6 8h12l2 4.5V16"/><path d="M4 16h16"/><circle cx="7.5" cy="16.5" r="1.5"/><circle cx="16.5" cy="16.5" r="1.5"/><path d="M6 12h12"/>`,
  home: `<path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v9h12v-9"/><path d="M10 19v-5h4v5"/>`,
  health: `<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>`,
  backpack: `<path d="M4 10a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M8 10h8"/><path d="M8 22v-6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v6"/><path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>`,
};
---
<svg
    class="info-card-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={icons[name]}
></svg>
