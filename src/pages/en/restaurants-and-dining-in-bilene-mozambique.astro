---
import MenuEN from '../../components/MenuEN.astro';
import Footer from '../../components/Footer.astro';
import Analytics from '../../components/Analytics.astro';
import Seo from '../../components/Seo.astro';
import { businessJsonLd } from '../../i18n/jsonld.js';
import '../../sass/general.scss';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Shrikhand&display=swap" rel="stylesheet">
    <Seo
        page="restaurants"
        lang="en"
        title="Restaurants and dining in Bilene, Mozambique"
        description="After the kite session, time to eat: the Palmeiras restaurant, the BKC team barbecue and our favourite dining spots in Bilene, Mozambique."
        image="/images/12-restaurants/Salleresto1.jpg">
        <script type="application/ld+json" set:html={JSON.stringify(businessJsonLd('en'))} />
    </Seo>
    <Analytics />
</head>
<body>
    <MenuEN page="restaurants" />

    <main>
        <section id="headsection">
            <img src="/images/12-restaurants/Salleresto1.jpg" alt="Evening atmosphere in a Bilene restaurant">
            <h1 style="text-shadow: 1px 1px 2px black;">Restaurants and dining in Bilene</h1>
            <h2 style="color: #b0cff7; text-shadow: 1px 1px 2px black;">After the water, time to eat</h2>
        </section>
        <section id="introinfos">
            <p>A day on the water deserves a great evening. In Bilene, good food is never far away — from the Palmeiras terrace with your feet in the sand, to the local tables we are happy to share with you.</p>
        </section>
        <section id="mainsection">

            <div class="flexdiv">
                <div class="flextext">
                    <h2>The Palmeiras restaurant</h2>
                    <p>
                        Right on site, with your feet in the sand, the Palmeiras restaurant and beach bar will be your
                        go-to from aperitif to dinner. Over a "2M" — the unmissable local beer — you can watch
                        the last riders finish their session from your sunbed.
                    </p>
                    <p>
                        Breakfast is served every morning, generous and very Mozambican. You may find chips on the
                        menu — that is the local take on a full breakfast, and if you would rather go without,
                        just ask!
                    </p>
                </div>
                <div class="fleximg">
                    <img src="/images/12-restaurants/Petidej-super-vue.jpg" alt="Breakfast overlooking the lagoon at the Palmeiras restaurant">
                    <img src="/images/12-restaurants/Sallerstovide.jpg" alt="Palmeiras restaurant terrace overlooking the beach">
                </div>
            </div>

            <div class="flexdiv background">
                <div class="flextext">
                    <h2>The BKC Team Barbecue</h2>
                    <p>
                        Once a week, we organise a team barbecue. Fresh produce, good company,
                        and the sunset over the lagoon as a backdrop — the perfect opportunity to share a drink
                        with fellow riders, swap stories from the day's best sessions and enjoy
                        an evening the way we like them.
                    </p>
                </div>
                <div class="fleximg">
                    <img src="/images/12-restaurants/grill-en-action.jpg" alt="Barbecue in action at a BKC team evening">
                    <img src="/images/12-restaurants/4personCoktail.jpeg" alt="Riders having drinks together in the evening in Bilene">
                </div>
            </div>

            <div class="flexdiv">
                <div class="flextext">
                    <h2>Our restaurant outings</h2>
                    <p>
                        Every other evening, we invite you to join us at our favourite spots in Bilene.
                        A handful of typical local restaurants run by locals, where the food is fresh, simple
                        and full of flavour. No tourist guide, no menu in four languages — just good tables
                        we eat at ourselves and are happy to share with you.
                    </p>
                </div>
                <div class="fleximg">
                    <img src="/images/12-restaurants/groupedinerresto.jpg" alt="Group of riders dining out in Bilene">
                    <img src="/images/12-restaurants/Tabléediner.jpeg" alt="Table set for dinner in Bilene">
                </div>
            </div>

        </section>
    </main>
    <Footer />
</body>
</html>
