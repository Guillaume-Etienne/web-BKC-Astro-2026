        height: 100%;
        object-fit: cover;
    }
    .blog-hero-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 40px 20px;
        background: linear-gradient(transparent, rgba(0,0,0,0.7));
        color: white;
    }
    .blog-hero-overlay h1 {
        font-size: 2.4em;
