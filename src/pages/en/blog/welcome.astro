---
import MenuEN from '../../../components/MenuEN.astro';
import Footer from '../../../components/Footer.astro';
import Analytics from '../../../components/Analytics.astro';
import '../../../sass/general.scss';
---

<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Shrikhand&display=swap" rel="stylesheet">
    <title>New! Massages at Bilene Kite Center</title>
    <meta name="description" content="Bilene Kite Center blog: discover our new wellness massage service facing the ocean in Mozambique">
    <Analytics />
</head>
<body>
    <MenuEN />

    <main>
        <div class="blog-hero">
            <img src="/images/blog/blog.webp" alt="blog Bilene Kite Center">
            <div class="blog-hero-overlay">
                <span class="blog-date">February 2026</span>
                <h1>New! Massages at Bilene Kite Center</h1>
            </div>
        </div>

        <article class="blog-article">
            <h2>New at Bilenekite: Wellness Massages Facing the Ocean</h2>
            <p>
                From now on, extend your Bilenekite experience with our <strong>relaxation massages</strong>, specially designed for kite enthusiasts and serenity lovers. Settle in under our thatched shelters, facing the sea, and let yourself be pampered between the sound of the waves and the gentle breeze.
            </p>
            <p>
                Perfect for loosening up your muscles after a session or simply enjoying a moment of calm, our massages blend naturally into your stay. <em>Relaxation guaranteed, energy restored</em> — all in a paradise setting.
            </p>
            <p>
                Available all season long. Book now!
            </p>
            <img src="/images/blog/massage.webp" alt="massage at Bilene Kite Center" class="blog-img">
            <a href="/en/blog" class="blog-back">&larr; Back to blog</a>
        </article>
    </main>

    <Footer />
</body>
</html>

<style>
    .blog-hero {
        position: relative;
        width: 100%;
        height: 560px;
        overflow: hidden;
    }
    .blog-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .blog-hero-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 40px 20px;
        background: linear-gradient(transparent, rgba(0,0,0,0.7));
        color: white;
    }
    .blog-hero-overlay h1 {
        font-size: 2.4em;
        margin: 8px 0 0;
        text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
    }
    .blog-hero-overlay .blog-date {
        font-size: 0.9em;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.9;
    }
    .blog-article {
        max-width: 750px;
        margin: 40px auto;
        padding: 0 20px;
    }
    .blog-article p {
        font-size: 1.05em;
        line-height: 1.8;
        text-align: left;
        color: #444;
        margin-bottom: 15px;
    }
    .blog-img {
        width: 100%;
        border-radius: 8px;
        margin: 25px 0;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    }
    .blog-back {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 20px;
        background: #4695fc;
        color: white;
        border-radius: 5px;
        font-weight: bold;
        transition: background 0.2s;
    }
    .blog-back:hover {
        background: #3578d8;
    }
    .blog-back:visited {
        color: white;
    }
    @media (max-width: 600px) {
        .blog-hero {
            height: 350px;
        }
        .blog-hero-overlay h1 {
            font-size: 1.6em;
        }
    }
</style>
