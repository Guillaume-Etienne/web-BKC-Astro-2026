---
import MenuEN from '../../components/MenuEN.astro';
import IconInfo from '../../components/IconInfo.astro';
import Footer from '../../components/Footer.astro';
import Analytics from '../../components/Analytics.astro';
import Seo from '../../components/Seo.astro';
import WhatsApp from '../../components/WhatsApp.astro';
import { businessJsonLd } from '../../i18n/jsonld.js';
import '../../sass/general.scss';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Anton&display=swap" rel="stylesheet">
    <Seo
        page="info"
        lang="en"
        title="Contact & practical information — Bilene Kite Center"
        description="Visa ETA, flights, transfer, accommodation, health: everything you need to prepare your kitesurf stay in Bilene, Mozambique. And to write to us directly.">
        <script type="application/ld+json" set:html={JSON.stringify(businessJsonLd('en'))} />
    </Seo>
    <Analytics />
</head>
<body>
    <MenuEN page="info" />

    <main>
        <section id="headsection">
            <img src="/images/7-infos/1.webp" alt="Bilene lagoon, Mozambique">
            <h1>Information & Contact</h1>
            <h2>The essentials for a smooth trip</h2>
        </section>

        <div class="info-intro">
            <p>The key facts to prepare your stay. For the full picture — checklist, airport tips, FAQs — it's all in our travel guide.</p>
        </div>
        <div class="info-guide-cta">
            <a href="/en/prepare-your-trip-to-bilene-mozambique/" class="btn">Full travel guide →</a>
        </div>

        <section class="info-cards" aria-label="Practical information">

            <!-- Flights -->
            <div class="info-card">
                <IconInfo name="flight" />
                <h3>Flights</h3>
                <p>Maputo is served by Ethiopian Airlines, Qatar Airways, South African Airways, Turkish Airlines and TAP Portugal (direct from Lisbon). Count on 10 to 11 hours of flying and roughly €700 return.</p>
                <div class="info-card-stats">
                    <span class="info-card-stat">10-11h flying</span>
                    <span class="info-card-stat">~€700 return</span>
                </div>
            </div>

            <!-- Visa / ETA -->
            <div class="info-card info-card--visa">
                <IconInfo name="visa" />
                <h3>Visa / ETA</h3>
                <p>Since 2025, nationals of 29 countries must obtain an <strong>ETA</strong> (Electronic Travel Authorization) before departure, via the official Mozambican portal. Allow several weeks ahead to be safe — your airline will check this document at boarding. Around $48. Passport valid for 6+ months after arrival is mandatory. We send you the accommodation letter needed for your application.</p>
                <details class="info-card-countries">
                    <summary>List of the 29 countries concerned</summary>
                    <ul class="info-countries-list">
                        <li>Belgium</li><li>Canada</li><li>China</li>
                        <li>Côte d'Ivoire</li><li>Denmark</li><li>Finland</li>
                        <li>France</li><li>Germany</li><li>Ghana</li>
                        <li>Indonesia</li><li>Ireland</li><li>Israel</li>
                        <li>Italy</li><li>Japan</li><li>Netherlands</li>
                        <li>Norway</li><li>Portugal</li><li>Russia</li>
                        <li>Saudi Arabia</li><li>Senegal</li><li>Singapore</li>
                        <li>South Korea</li><li>Spain</li><li>Sweden</li>
                        <li>Switzerland</li><li>Ukraine</li><li>United Arab Emirates</li>
                        <li>United Kingdom</li><li>United States</li>
                    </ul>
                    <p class="info-countries-note">Sources: <a href="https://evisa.gov.mz/" target="_blank" rel="noopener">evisa.gov.mz</a> · <a href="https://visasnews.com/en/mozambique-eta-now-mandatory-for-travelers-from-29-visa-exempt-countries/" target="_blank" rel="noopener">VisasNews</a> · <a href="https://www.mozambiquetravel.com/blog/visa-waiver-for-29-countries-visiting-mozambique/" target="_blank" rel="noopener">mozambiquetravel.com</a></p>
                </details>
                <div class="info-card-links">
                    <a href="https://evisa.gov.mz/" target="_blank" rel="noopener">→ Official ETA / eVisa portal</a>
                    <a href="https://visasnews.com/en/mozambique-e-visa-and-eta-application-portal-gets-a-makeover/" target="_blank" rel="noopener">→ Latest changes (VisasNews)</a>
                </div>
            </div>

            <!-- Transfer -->
            <div class="info-card">
                <IconInfo name="car" />
                <h3>Transfer</h3>
                <p>Around 3 hours by road from Maputo, on a well-maintained tarmac road through typical African landscapes. We book the vehicle for you. New option: arrive by Cessna, flying over the turquoise lagoons.</p>
                <div class="info-card-stats">
                    <span class="info-card-stat">~3h by road</span>
                    <span class="info-card-stat">Cessna option</span>
                </div>
                <div class="info-card-links">
                    <a href="/en/prepare-your-trip-to-bilene-mozambique/#the-transfer">→ Transfer details</a>
                </div>
            </div>

            <!-- Accommodation -->
            <div class="info-card">
                <IconInfo name="home" />
                <h3>Accommodation</h3>
                <p>Our centre is on the beach at the Palmeiras complex — wi-fi, bar and restaurant right on the spot. Other options available in Bilene to suit your preferences and budget.</p>
                <div class="info-card-links">
                    <a href="/en/lodging-in-bilene-mozambique/">→ See accommodation</a>
                </div>
            </div>

            <!-- Health -->
            <div class="info-card">
                <IconInfo name="health" />
                <h3>Health</h3>
                <p>No vaccinations required. Antimalarials recommended only if you plan a safari or city visit. Teresa, co-founder, is an emergency nurse at the International Red Cross — you're in safe hands.</p>
            </div>

            <!-- What to bring -->
            <div class="info-card">
                <IconInfo name="backpack" />
                <h3>What to bring</h3>
                <p>Lycra is the priority. Sunscreen, kite-friendly sunglasses, a cap, cash in euros. A light jumper just in case. A basic first-aid kit is advised.</p>
                <div class="info-card-links">
                    <a href="/en/prepare-your-trip-to-bilene-mozambique/#what-to-bring">→ Full packing list</a>
                </div>
            </div>

        </section>

        <figure class="info-break">
            <img src="/images/7-infos/7.webp" alt="Friendly atmosphere at Bilene Kite Center">
            <figcaption>The warm welcome of Bilene village</figcaption>
        </figure>

        <section id="contactus">
            <div class="contact-card">
                <h2>Write to us</h2>
                <p>No bots — a real person on the other end.</p>
                <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSeK2bYq3kie_E8u55hC1iC6l6-JtUzieJP8Ri9qw58BCFvycw/viewform?embedded=true" width="100%" height="981" scrolling="no">Loading...</iframe>
            </div>
        </section>

    </main>

    <WhatsApp page="info" lang="en" variant="bubble" />


    <Footer />
</body>
</html>
