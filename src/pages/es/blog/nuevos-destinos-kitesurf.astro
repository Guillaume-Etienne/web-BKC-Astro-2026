        font-size: 2.4em;
        margin: 8px 0 0;
        text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
    }
    .blog-hero-overlay .blog-date {
        font-size: 0.9em;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.9;
    }
    .blog-article {
        /* main est un conteneur flex en colonne et "margin: auto" neutralise
           l'etirement : sans width explicite, l'article prend sa largeur de
           contenu (750px) meme sur un ecran de 375px. */
        width: 100%;
        max-width: 750px;
        margin: 40px auto;
        padding: 0 20px;
    }
    .blog-article h2 {
        margin-top: 40px;
        font-size: 1.4em;
    }
    .blog-article p {
        font-size: 1.05em;
        line-height: 1.8;
        text-align: left;
        color: #444;
        margin-bottom: 15px;
    }
    .blog-img {
        width: 100%;
        border-radius: 8px;
        margin: 25px 0;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    }
    .blog-table-wrap {
        overflow-x: auto;
        margin: 25px 0;
    }
    .blog-table-wrap table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95em;
    }
    .blog-table-wrap th,
    .blog-table-wrap td {
        padding: 10px 12px;
        border-bottom: 1px solid #e2e8f0;
