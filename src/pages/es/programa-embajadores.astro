---
// ============================================================================
//  PROGRAMA DE EMBAJADORES — page ES, pendant de /programme-ambassadeurs/
// ----------------------------------------------------------------------------
//  Meme regime que la page FR : volontairement HORS de src/i18n/pages.js
//  (pas de hreflang ni de switcher base sur pages.js), noindex, exclue du
//  sitemap (astro.config.mjs). <Seo> est quand meme utilise pour l'apercu
//  de lien dans le mailing (og:title/description/image).
//
//  /!\ Le texte n'est PAS une traduction de la page francaise : il a ete
//  reecrit en espagnol le 21/09/2026, la traduction ayant ete rejetee par
//  Teresa (calques et typographie francaise). Memes faits, memes paliers,
//  autre plume. Detail des regles dans l'en-tete de
//  tools/mailing/gen-mailing-clubs-escuelas-es.cjs — les deux textes doivent
//  rester du meme espagnol, le mail amene sur cette page.
//
//  Cible : le mailing de prospection vers les ecoles et clubs espagnols
//  (campagne Brevo "Club ES"). Teresa repond en espagnol.
// ============================================================================
import MenuES from '../../components/MenuES.astro';
import Footer from '../../components/Footer.astro';
import Analytics from '../../components/Analytics.astro';
import Seo from '../../components/Seo.astro';
import WhatsApp from '../../components/WhatsApp.astro';
import Reviews from '../../components/Reviews.astro';
import { enquiryFormUrl } from '../../i18n/enquiryForm.js';
import '../../sass/general.scss';
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Anton&display=swap" rel="stylesheet">
    <Seo
        page="programme-ambassadeurs"
        lang="es"
        noindex={true}
        title="Programa de Embajadores — Bilene Kite Center"
        description="Monta un grupo para venir a navegar a Bilene y tu viaje te sale gratis a partir de tres personas. Cuanto más grande es el grupo, más ventajas."
        image="/images/11-Accomodation/Palm_view.jpg"
    />
    <Analytics />
</head>
<body>

    <MenuES page="programme-ambassadeurs" />

    <main>

        <!-- ─── MASTHEAD ─────────────────────────────────────── -->
        <section class="amb-hero">
            <p class="amb-eyebrow">Bilene Kite Center · Mozambique</p>
            <h1>Programa de Embajadores</h1>
            <p>Monta un grupo para venir a navegar a Bilene y viaja por mucho menos, o gratis del todo. Cuanto más grande sea el grupo, más ventajas, hasta una tarjeta regalo para tu billete de avión a partir de diez personas.</p>
        </section>

        <!-- ─── TRES PERFILES ────────────────────────────────── -->
        <section class="amb-section">
            <p class="amb-section-label">Cómo funciona</p>
            <h2>Tres perfiles, un mismo trato</h2>
            <p class="amb-lead">El programa se adapta a cómo navegas: si vienes con tu material, si lo alquilas aquí, o si tu grupo todavía está aprendiendo.</p>
            <p class="amb-anchor-note">Con 3 personas que vengan contigo, tu viaje te sale gratis (alojamiento, traslados y material guardado)</p>

            <div class="amb-tiers">

                <div class="acc-item is-open" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="true">
                        <span class="acc-head-content">
                            <span class="amb-badge">A</span>
                            <span class="amb-tier-title">
                                <span class="acc-title">Riders independientes</span>
                                <span class="amb-tier-sub">Vienes con tu propio material</span>
                            </span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-tier-rows">
                                <div class="amb-tier-row"><span class="amb-amene">1-2 personas</span><span class="amb-avantage">10% de descuento en el alojamiento y el material guardado gratis</span></div>
                                <div class="amb-tier-row amb-tier-row--highlight"><span class="amb-amene">3 personas</span><span class="amb-avantage">Viaje completo gratis (vuelos y visados aparte)</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">4-6 personas</span><span class="amb-avantage">+ 40% de descuento en el alquiler de material<br>+ 1 sesión de prueba de medio día con material Eleveight 2027</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">7 personas</span><span class="amb-avantage">+ 2 sesiones de prueba de medio día con material Eleveight 2027</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">10 o más</span><span class="amb-avantage">+ tarjeta regalo de unos 90€ por persona para el billete de avión</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="amb-badge">B</span>
                            <span class="amb-tier-title">
                                <span class="acc-title">Alquiler de material</span>
                                <span class="amb-tier-sub">No traes equipo, lo alquilas aquí</span>
                            </span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-tier-rows">
                                <div class="amb-tier-row"><span class="amb-amene">1-2 personas</span><span class="amb-avantage">20% de descuento en el alojamiento y el material guardado gratis</span></div>
                                <div class="amb-tier-row amb-tier-row--highlight"><span class="amb-amene">3 personas</span><span class="amb-avantage">Viaje completo gratis (vuelos y visados aparte)</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">4-6 personas</span><span class="amb-avantage">+ 50% de descuento en el alquiler de material<br>+ 2 sesiones de prueba de medio día con material Eleveight 2027</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">7 personas</span><span class="amb-avantage">+ 3 sesiones de prueba de medio día con material Eleveight 2027</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">10 o más</span><span class="amb-avantage">+ tarjeta regalo de unos 115€ por persona para el billete de avión</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="amb-badge">C</span>
                            <span class="amb-tier-title">
                                <span class="acc-title">Clases</span>
                                <span class="amb-tier-sub">Empiezas ahora, o tu grupo viene a aprender</span>
                            </span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-tier-rows">
                                <div class="amb-tier-row"><span class="amb-amene">1-2 personas</span><span class="amb-avantage">25% de descuento en el alojamiento y en las excursiones</span></div>
                                <div class="amb-tier-row amb-tier-row--highlight"><span class="amb-amene">3 personas</span><span class="amb-avantage">Viaje completo gratis (vuelos y visados aparte)</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">4-6 personas</span><span class="amb-avantage">+ pack de 4h de clases gratis</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">7 personas</span><span class="amb-avantage">+ pack de 10h de clases gratis</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">10 o más</span><span class="amb-avantage">+ tarjeta regalo de unos 120€ por persona para el billete de avión</span></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- ─── EJEMPLO DE VIAJE ─────────────────────────────── -->
        <section class="amb-package-hero">
            <p class="amb-eyebrow">Bilene Kite Center · Mozambique</p>
            <h2>Siete noches en una laguna virgen: kite, playa y la luna de Bilene</h2>
            <p>Un viaje cerrado para grupos de cuatro, para descubrir el mejor spot del sur de Mozambique sin tener que organizar nada.</p>
            <div class="amb-price-tag">
                <span class="amb-amount">690€</span>
                <span class="amb-unit">por persona</span>
            </div>
        </section>

        <section class="amb-section">
            <p class="amb-section-label">El viaje que les organizas</p>
            <h2>Está todo montado, solo queda navegar</h2>
            <p class="amb-lead">Un viaje completo para no tener que pensar en nada más que en el viento, la laguna y el grupo.</p>

            <div class="amb-quick-items">
                <div class="amb-qi"><span class="amb-dot"></span><div><strong>Traslado aeropuerto – Bilene</strong><span>Ida y vuelta, os recogemos al salir del avión</span></div></div>
                <div class="amb-qi"><span class="amb-dot"></span><div><strong>El spot, a pie de playa</strong><span>Zona segura, duchas y sitio para estar</span></div></div>
                <div class="amb-qi"><span class="amb-dot"></span><div><strong>Aquí no montas ni recoges</strong><span>Nuestros asistentes montan tu equipo y lo guardan en almacén cerrado</span></div></div>
            </div>

            <div class="amb-included">

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">Siete noches en chalet en primera línea</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/11-Accomodation/Palm_Bung.jpg" alt="Camino con sombra entre los bungalows del centro" loading="lazy">
                                <p>Habitación doble compartida, salón con cocina, dos baños y terraza mirando a la playa.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">Excursión al Limpopo</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/4-trips/8.webp" alt="El faro y la desembocadura del río Limpopo desde el aire" loading="lazy" class="amb-img-full">
                                <p>Un día entero, con la comida incluida.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">Excursión a Macia</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/2-excursions/Macia.webp" alt="Mercado local de Macia" loading="lazy">
                                <p>Una mañana de pueblo y mercado.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">La laguna desde el aire</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/2-excursions/autres.webp" alt="Vista aérea de la laguna de Bilene, con el brazo de mar y los bancos de arena" loading="lazy">
                                <p>Brazo de mar, bancos de arena y dunas, a unos minutos del centro.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">Masaje de 45 minutos</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/blog/massage.webp" alt="Masaje de 45 minutos" loading="lazy" class="amb-img-top">
                                <p>Para después de las sesiones.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <div class="amb-note-band">
            <div class="amb-note-badge">+</div>
            <div>
                <h3>Si lo necesitas</h3>
                <p>Alquiler de material Eleveight (50€ el medio día) o clases particulares con instructor IKO (desde 120€), para quien todavía no tiene equipo o está empezando.</p>
            </div>
        </div>

        <Reviews lang="es" />

        <div class="amb-cta" id="amb-contact">
            <h2>¿Montamos tu grupo?</h2>
            <p>No hace falta que lo tengas cerrado. Dinos cuántos creéis que seréis y en qué fechas, y te decimos qué ventajas os tocan y cuánto sale exactamente.</p>
            <WhatsApp page="ambassador" lang="es" label="Escríbenos por WhatsApp" />
            <p class="amb-fine">Precio orientativo para un grupo de cuatro · vuelos y visados aparte</p>
            <!-- Meme logique que la page FR : WhatsApp reste le CTA principal, le
                 formulaire est la pour qui prefere ecrire sans quitter la page.
                 data-page-key inchange ("ambassador") : c'est <html lang="es"> qui
                 distingue la provenance espagnole dans GA4 (page_language). -->
            <div class="lp-form-card">
                <p class="lp-form-note">O escríbenos aquí mismo, sin salir de la página.</p>
                <iframe
                    id="bkc-enquiry"
                    data-page-key="ambassador"
                    title="Formulario de contacto del Bilene Kite Center"
                    src={enquiryFormUrl('es')}
                    style="width:100%;border:0;display:block;height:560px"
                    loading="lazy"></iframe>
            </div>
        </div>

    </main>

    <Footer />
    <script is:inline src="/js/accordion.js?v=2"></script>
</body>
</html>
