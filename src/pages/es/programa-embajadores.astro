---
// ============================================================================
//  PROGRAMA EMBAJADORES — version ES de /programme-ambassadeurs/ (noindex)
// ----------------------------------------------------------------------------
//  Meme regime que la page FR : volontairement HORS de src/i18n/pages.js
//  (pas de hreflang ni de switcher base sur pages.js), noindex, exclue du
//  sitemap (astro.config.mjs). <Seo> est quand meme utilise pour l'apercu
//  de lien dans le mailing (og:title/description/image).
//  Cible : le mailing de prospection vers les ecoles et clubs espagnols
//  (tools/mailing/, campagne Brevo "Club ES"). Teresa repond en espagnol.
// ============================================================================
import MenuES from '../../components/MenuES.astro';
import Footer from '../../components/Footer.astro';
import Analytics from '../../components/Analytics.astro';
import Seo from '../../components/Seo.astro';
import WhatsApp from '../../components/WhatsApp.astro';
import Reviews from '../../components/Reviews.astro';
import { enquiryFormUrl } from '../../i18n/enquiryForm.js';
import '../../sass/general.scss';
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Anton&display=swap" rel="stylesheet">
    <Seo
        page="programme-ambassadeurs"
        lang="es"
        noindex={true}
        title="Programa Embajadores — Bilene Kite Center"
        description="Organiza un grupo para venir a navegar a Bilene y viaja a menor coste, o incluso gratis. Cuanto más grande es el grupo, mayores son las ventajas."
        image="/images/11-Accomodation/Palm_view.jpg"
    />
    <Analytics />
</head>
<body>

    <MenuES page="programme-ambassadeurs" />

    <main>

        <!-- ─── MASTHEAD ─────────────────────────────────────── -->
        <section class="amb-hero">
            <p class="amb-eyebrow">Bilene Kite Center · Mozambique</p>
            <h1>Programa Embajadores</h1>
            <p>Organiza un grupo para venir a navegar a Bilene y viaja a menor coste — o incluso gratis. Cuanto más grande es tu grupo, mayores son las ventajas, hasta un cheque regalo para tu billete de avión a partir de 10 personas traídas.</p>
        </section>

        <!-- ─── TRES PERFILES ────────────────────────────────── -->
        <section class="amb-section">
            <p class="amb-section-label">Cómo funciona</p>
            <h2>Tres perfiles, un mismo principio</h2>
            <p class="amb-lead">El programa se adapta a tu forma de navegar: tanto si vienes con tu propio material, como si lo alquilas aquí, o si quieres que tu grupo descubra el kite.</p>
            <p class="amb-anchor-note">A partir de 3 personas traídas: viaje completo gratis (alojamiento, traslados, storage)</p>

            <div class="amb-tiers">

                <div class="acc-item is-open" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="true">
                        <span class="acc-head-content">
                            <span class="amb-badge">A</span>
                            <span class="amb-tier-title">
                                <span class="acc-title">Riders independientes</span>
                                <span class="amb-tier-sub">Viajas con tu propio material</span>
                            </span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-tier-rows">
                                <div class="amb-tier-row"><span class="amb-amene">1-2 personas</span><span class="amb-avantage">10% de descuento en el alojamiento + storage gratis</span></div>
                                <div class="amb-tier-row amb-tier-row--highlight"><span class="amb-amene">3 personas</span><span class="amb-avantage">Viaje completo gratis (vuelos y visados no incluidos)</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">4-6 personas</span><span class="amb-avantage">+ 40% de descuento en el alquiler de material<br>+ 1 sesión de prueba de medio día con el equipo Eleveight 2027</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">7 personas</span><span class="amb-avantage">+ 2 sesiones de prueba de medio día con el equipo Eleveight 2027</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">10+ personas</span><span class="amb-avantage">+ cheque regalo de ~90€/persona traída para el billete de avión</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="amb-badge">B</span>
                            <span class="amb-tier-title">
                                <span class="acc-title">Alquiler de material</span>
                                <span class="amb-tier-sub">No tienes equipo, lo alquilas aquí</span>
                            </span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-tier-rows">
                                <div class="amb-tier-row"><span class="amb-amene">1-2 personas</span><span class="amb-avantage">20% de descuento en el alojamiento + storage gratis</span></div>
                                <div class="amb-tier-row amb-tier-row--highlight"><span class="amb-amene">3 personas</span><span class="amb-avantage">Viaje completo gratis (vuelos y visados no incluidos)</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">4-6 personas</span><span class="amb-avantage">+ 50% de descuento en el alquiler de material<br>+ 2 sesiones de prueba de medio día con el equipo Eleveight 2027</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">7 personas</span><span class="amb-avantage">+ 3 sesiones de prueba de medio día con el equipo Eleveight 2027</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">10+ personas</span><span class="amb-avantage">+ cheque regalo de ~115€/persona traída para el billete de avión</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="amb-badge">C</span>
                            <span class="amb-tier-title">
                                <span class="acc-title">Clases</span>
                                <span class="amb-tier-sub">Empiezas en el kite o quieres que tu grupo descubra el deporte</span>
                            </span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-tier-rows">
                                <div class="amb-tier-row"><span class="amb-amene">1-2 personas</span><span class="amb-avantage">25% de descuento en el alojamiento + excursiones</span></div>
                                <div class="amb-tier-row amb-tier-row--highlight"><span class="amb-amene">3 personas</span><span class="amb-avantage">Viaje completo gratis (vuelos y visados no incluidos)</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">4-6 personas</span><span class="amb-avantage">+ pack de 4h de clases gratis</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">7 personas</span><span class="amb-avantage">+ pack de 10h de clases gratis</span></div>
                                <div class="amb-tier-row"><span class="amb-amene">10+ personas</span><span class="amb-avantage">+ cheque regalo de ~120€/persona traída para el billete de avión</span></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- ─── EJEMPLO DE ESTANCIA ──────────────────────────── -->
        <section class="amb-package-hero">
            <p class="amb-eyebrow">Bilene Kite Center · Mozambique</p>
            <h2>7 noches en una laguna virgen, entre kite, playa y la luna de Bilene</h2>
            <p>Una estancia llave en mano para un grupo de 4, pensada para descubrir el mejor spot del sur de Mozambique sin tener que organizar nada.</p>
            <div class="amb-price-tag">
                <span class="amb-amount">690€</span>
                <span class="amb-unit">por persona</span>
            </div>
        </section>

        <section class="amb-section">
            <p class="amb-section-label">La estancia que le ofreces a tu grupo</p>
            <h2>Está todo previsto, solo queda volar</h2>
            <p class="amb-lead">Una estancia completa pensada para centrarse en lo esencial: el viento, la laguna y el grupo.</p>

            <div class="amb-quick-items">
                <div class="amb-qi"><span class="amb-dot"></span><div><strong>Traslado aeropuerto – Bilene</strong><span>Ida y vuelta, a cargo nuestro desde que salís del avión</span></div></div>
                <div class="amb-qi"><span class="amb-dot"></span><div><strong>Spot directamente en la playa</strong><span>Zona segura, duchas, espacio chill</span></div></div>
                <div class="amb-qi"><span class="amb-dot"></span><div><strong>Storage de material</strong><span>Guardado seguro para vuestro equipo durante toda la estancia</span></div></div>
            </div>

            <div class="amb-included">

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">7 noches en chalet en primera línea</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/11-Accomodation/Palm_Bung.jpg" alt="Camino sombreado entre los bungalows del centro" loading="lazy">
                                <p>Habitación doble compartida, salón-cocina, 2 baños, terraza frente a la playa.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">Excursión al Limpopo</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/4-trips/8.webp" alt="El faro y la desembocadura del río Limpopo, vistos desde el cielo" loading="lazy" class="amb-img-full">
                                <p>Día de descubrimiento con comida incluida.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">Excursión a Macia</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/2-excursions/Macia.webp" alt="Mercado local de Macia" loading="lazy">
                                <p>Una mañana de pueblo y mercado local.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">La laguna vista desde el cielo</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/2-excursions/autres.webp" alt="Vista aérea de la laguna de Bilene, brazo de mar y bancos de arena" loading="lazy">
                                <p>Brazo de mar, bancos de arena y dunas, a pocos minutos del centro.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acc-item" data-acc>
                    <button class="acc-header amb-acc-header" aria-expanded="false">
                        <span class="acc-head-content">
                            <span class="acc-title">Masaje de 45 minutos</span>
                        </span>
                        <span class="acc-toggle" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    <div class="acc-panel">
                        <div class="acc-panel-inner">
                            <div class="acc-body amb-included-body">
                                <img src="/images/blog/massage.webp" alt="Masaje relajante de 45 minutos" loading="lazy" class="amb-img-top">
                                <p>Un momento de relax después de las sesiones.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <div class="amb-note-band">
            <div class="amb-note-badge">+</div>
            <div>
                <h3>Opcional, según tu perfil</h3>
                <p>Alquiler de material Eleveight (50€/medio día) o clases particulares con un instructor IKO (desde 120€), para quienes todavía no tienen equipo o están empezando.</p>
            </div>
        </div>

        <Reviews lang="es" />

        <div class="amb-cta" id="amb-contact">
            <h2>¿Listo para ser embajador?</h2>
            <p>No hace falta que tengas el grupo cerrado: dinos cuántos pensáis ser y en qué fechas, y te respondemos con las ventajas que os corresponden y un presupuesto preciso.</p>
            <WhatsApp page="ambassador" lang="es" label="Escríbenos por WhatsApp" />
            <p class="amb-fine">Precio orientativo para un grupo de 4 personas · vuelos y visados no incluidos</p>
            <!-- Meme logique que la page FR : WhatsApp reste le CTA principal, le
                 formulaire est la pour qui prefere ecrire sans quitter la page.
                 data-page-key inchange ("ambassador") : c'est <html lang="es"> qui
                 distingue la provenance espagnole dans GA4 (page_language). -->
            <div class="lp-form-card">
                <p class="lp-form-note">O escríbenos aquí mismo, sin salir de la página.</p>
                <iframe
                    id="bkc-enquiry"
                    data-page-key="ambassador"
                    title="Formulario de contacto del Bilene Kite Center"
                    src={enquiryFormUrl('es')}
                    style="width:100%;border:0;display:block;height:560px"
                    loading="lazy"></iframe>
            </div>
        </div>

    </main>

    <Footer />
    <script is:inline src="/js/accordion.js?v=2"></script>
</body>
</html>
